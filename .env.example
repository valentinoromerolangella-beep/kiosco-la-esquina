# ---------------------------------------------------------------------------
# Kiosco El Rápido - variables de entorno de ejemplo
# Copiar este archivo como .env en la raíz del proyecto:
#   Windows:        Copy-Item .env.example .env
#   Linux / macOS:  cp .env.example .env
# ---------------------------------------------------------------------------

# Frontend (Vite).
# Si no se define, el frontend usa "/api" y el proxy de Vite redirige al backend.
# Para llamar directamente a FastAPI podés usar:
# VITE_API_URL=http://127.0.0.1:8000/api
VITE_API_URL=http://127.0.0.1:8000/api

# Backend: orígenes permitidos por CORS, separados por coma.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Backend: ruta opcional del archivo SQLite.
# Por defecto se usa backend/database.db.
# DATABASE_PATH=./backend/database.db
